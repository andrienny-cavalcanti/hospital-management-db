digraph DER {
	nodesep=0.45 rankdir=LR ranksep=0.8 splines=ortho
	node [fontname=Arial fontsize=9 shape=record]
	PESSOA [label="{PESSOA|PK id_pessoa\lnome\lcpf UQ\ldata_nascimento\lis_flamengo\ltelefone\l}"]
	PACIENTE [label="{PACIENTE|PK/FK id_pessoa\lnum_convenio UQ\lalergias\lgrupo_sanguineo\lendereco\l}"]
	PROFISSIONAL [label="{PROFISSIONAL|PK/FK id_pessoa\lcrm UQ\ldata_admissao\lespecialidade\l}"]
	RESIDENTE [label="{RESIDENTE|PK/FK id_profissional\lano_residencia\l}"]
	PRECEPTOR [label="{PRECEPTOR|PK/FK id_profissional\ltitulacao\l}"]
	UNIDADE [label="{UNIDADE|PK id_unidade\lnome UQ\ltipo\lcapacidade_leitos\l}"]
	ATENDIMENTO [label="{ATENDIMENTO|PK id_atendimento\ldata_hora\lduracao_minutos\lFK id_paciente\lFK id_residente\lFK id_preceptor\l}"]
	PROCEDIMENTO [label="{PROCEDIMENTO|PK id_procedimento\lcodigo UQ\lnome\ltempo_medio_minutos\lnivel_risco\l}"]
	PROC_REALIZADO [label="{PROCEDIMENTO_REALIZADO|PK/FK id_atendimento\lPK/FK id_procedimento\lquantidade\ltempo_real_minutos\lobservacao\lfaturado\l}"]
	ESCALA [label="{ESCALA|PK id_escala\lFK id_unidade\ldata_plantao\ldia_semana\lturno\lFK id_residente\lFK id_preceptor\lUQ unidade+dia+turno+residente\l}"]
	PESSOA -> PACIENTE [label="1 -> 0..1"]
	PESSOA -> PROFISSIONAL [label="1 -> 0..1"]
	PROFISSIONAL -> RESIDENTE [label="1 -> 0..1"]
	PROFISSIONAL -> PRECEPTOR [label="1 -> 0..1"]
	PACIENTE -> ATENDIMENTO [label="1 -> N"]
	RESIDENTE -> ATENDIMENTO [label="1 -> N"]
	PRECEPTOR -> ATENDIMENTO [label="1 -> N"]
	ATENDIMENTO -> PROC_REALIZADO [label="1 -> N"]
	PROCEDIMENTO -> PROC_REALIZADO [label="1 -> N"]
	UNIDADE -> ESCALA [label="1 -> N"]
	RESIDENTE -> ESCALA [label="1 -> N"]
	PRECEPTOR -> ESCALA [label="1 -> N"]
}
